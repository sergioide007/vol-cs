---
// Raíz del dominio: redirige según el idioma del navegador (ES por defecto).
// La URL canónica sale de site.config.json (NO la escribas a mano).
import site from '../../site.config.json';
const base = site.url.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Código Sintético · Synthetic Code</title>
    <meta http-equiv="refresh" content="0; url=/es/" />
    <link rel="canonical" href={`${base}/es/`} />
    <link rel="alternate" hreflang="es" href={`${base}/es/`} />
    <link rel="alternate" hreflang="en" href={`${base}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${base}/es/`} />
    <script is:inline>
      if ((navigator.language || '').toLowerCase().startsWith('en')) location.replace('/en/');
    </script>
  </head>
  <body><p><a href="/es/">Español</a> · <a href="/en/">English</a></p></body>
</html>
